{
  "title": "OrderFlow API - Performance & Observability (k6)",
  "uid": "k6-orderflow-perf",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Latência de Resposta - p(95) & Média (ms)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "k6-influxdb" },
      "targets": [
        {
          "measurement": "http_req_duration",
          "select": [[{ "type": "field", "params": ["value"] }, { "type": "percentile", "params": [95] }]],
          "alias": "p(95) ms"
        },
        {
          "measurement": "http_req_duration",
          "select": [[{ "type": "field", "params": ["value"] }, { "type": "mean", "params": [] }]],
          "alias": "Média ms"
        }
      ]
    },
    {
      "id": 2,
      "title": "Usuários Virtuais Simultâneos (VUs)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "k6-influxdb" },
      "targets": [
        {
          "measurement": "vus",
          "select": [[{ "type": "field", "params": ["value"] }, { "type": "max", "params": [] }]],
          "alias": "VUs Ativos"
        }
      ]
    },
    {
      "id": 3,
      "title": "Vazão / Requisições por Segundo (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "k6-influxdb" },
      "targets": [
        {
          "measurement": "http_reqs",
          "select": [[{ "type": "field", "params": ["value"] }, { "type": "count", "params": [] }]],
          "alias": "Requisições"
        }
      ]
    },
    {
      "id": 4,
      "title": "Erros HTTP (Status != 200)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "k6-influxdb" },
      "targets": [
        {
          "measurement": "http_req_failed",
          "select": [[{ "type": "field", "params": ["value"] }, { "type": "sum", "params": [] }]],
          "alias": "Falhas"
        }
      ]
    }
  ]
}
